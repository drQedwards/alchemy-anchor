# Copy to .env and fill in. Never commit .env.

# Alchemy node / websocket / Solana RPC (dashboard.alchemy.com)
ALCHEMY_API_KEY=

# Optional: Circle USDC watcher destination on Ethereum mainnet (0x…)
WATCH_ETH_ADDRESS=

# Alchemy Pay merchant credentials (ramp.alchemypay.org) — not the node key
ALCHEMY_PAY_APP_ID=
ALCHEMY_PAY_SECRET=
ALCHEMY_PAY_ENV=sandbox

# SEP-10 signing secret (S…). Public counterpart is SIGNING_KEY in stellar.toml
STELLAR_SIGNING_SECRET=

# HMAC secret for SEP-10 JWTs
JWT_SECRET=

# Public origin the wallet uses to find this anchor
HOME_DOMAIN=localhost:8787
PORT=8787

# Robinhood Chain mainnet (read). Defaults to public RPC if unset.
# ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# MoonPay UUID confirmation for minted-coin disbursement (sk_ never in git)
MOONPAY_SECRET_KEY=
MOONPAY_PUBLISHABLE_KEY=

# Drips Wave grant CLI (scripts/drips-wave-grant.cjs) — never commit real tokens
WAVE_API_URL=https://wave-api.drips.network
WAVE_GRANT_ID=
WAVE_ACCESS_TOKEN=
WAVE_REFRESH_TOKEN=
STELLAR_ADDRESS=
MEMO_TYPE=
MEMO_VALUE=
# WAVE_LIVE=1
