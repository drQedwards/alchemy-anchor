# Copy to .env and fill in. Never commit .env.

# Alchemy node / websocket / Solana RPC (dashboard.alchemy.com)
ALCHEMY_API_KEY=

# Optional: Circle USDC watcher destination on Ethereum mainnet (0x…)
WATCH_ETH_ADDRESS=

# Alchemy Pay merchant credentials (ramp.alchemypay.org) — not the node key
ALCHEMY_PAY_APP_ID=
ALCHEMY_PAY_SECRET=
ALCHEMY_PAY_ENV=sandbox

# SEP-10 signing secret (S…). Public counterpart is SIGNING_KEY in stellar.toml
STELLAR_SIGNING_SECRET=

# HMAC secret for SEP-10 JWTs
JWT_SECRET=

# Public origin the wallet uses to find this anchor
HOME_DOMAIN=localhost:8787
PORT=8787
